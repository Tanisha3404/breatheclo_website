# Copy this file to ".env" and fill it in. Never commit ".env".

# Local MongoDB (the one Compass connects to). For MongoDB Atlas paste its connection string instead.
MONGODB_URI=mongodb://127.0.0.1:27017/breatheclo

PORT=5000

# Firebase project used for login (same as projectId in frontend/js/auth.js). No secret key needed.
FIREBASE_PROJECT_ID=breathecloauth

# Firebase user IDs allowed to open the admin page, comma separated.
# Sign up on the site, then copy your "User UID" from Firebase console > Authentication > Users.
ADMIN_UIDS=

# Only needed once the frontend is hosted somewhere else (for example GitHub Pages), comma separated.
# CLIENT_ORIGINS=https://yourname.github.io

# Starting stock for products created by "npm run seed"
# SEED_STOCK=50
